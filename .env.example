# ---- Core ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ---- Database ----
# Application role. Must NOT be the table owner and must NOT have BYPASSRLS,
# otherwise the Row-Level Security backstop (§4.4) silently does nothing.
# Port 5433, not 5432 — see docker-compose.yml. A locally installed Postgres on
# 5432 would silently receive these connections and fail authentication.
DATABASE_URL=postgresql://cms_app:cms_app@localhost:5433/cms?schema=public
# Owner/migration role, used only by Prisma migrate and the RLS bootstrap script.
DATABASE_ADMIN_URL=postgresql://cms:cms@localhost:5433/cms?schema=public

# ---- Delivery API keys ----
API_KEY_RATE_LIMIT_ENABLED=true
API_KEY_RATE_LIMIT_PUBLISHABLE_PER_MINUTE=300
API_KEY_RATE_LIMIT_SECRET_PER_MINUTE=1000

# ---- Background jobs ----
# Jobs live in the `jobs` table in Postgres; there is no broker. The API process
# both queues and runs them by default. To separate the two in production, set
# JOB_WORKER_ENABLED=false on web instances and run others with it true — they
# claim work with FOR UPDATE SKIP LOCKED, so any number can share the queue.
JOB_QUEUE_ENABLED=true
JOB_WORKER_ENABLED=true
# How often a worker looks for due jobs, and how many it takes at a time.
JOB_POLL_INTERVAL_MS=5000
JOB_BATCH_SIZE=10
# A job still claimed after this long is assumed to belong to a dead process and
# is released. Must exceed your slowest job or it will be run twice.
JOB_CLAIM_TIMEOUT_MS=300000

# ---- Auth ----
# 32+ random bytes, base64. Rotate via JWT_SECRET_PREVIOUS for zero-downtime rollover.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- Email (dev: mailhog) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="CMS Platform <no-reply@localhost>"

# ---- Encryption at rest ----
# Envelope-encryption keys for provider credentials (§18.2). Format:
# `keyId:base64key` entries, newest first — rotation keeps the old key listed so
# values encrypted under it still decrypt.
# Generate: node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
# Required in production; development falls back to a key derived from JWT_SECRET.
ENCRYPTION_KEYS=

# ---- Email (Resend) ----
# There is no platform-wide Resend key. Each organisation adds its own
# configuration in organisation settings, and each site selects one. Keys are
# stored encrypted and never returned by the API.
# Webhook URL to paste into Resend: {API_URL}/webhooks/email/{configuration_id}

# ---- Media storage ----
# Leave S3_BUCKET unset to use the local-disk driver: objects go under
# MEDIA_ROOT and uploads are presigned against this API. The client-side upload
# flow is identical either way, so code written against local storage works
# against S3 unchanged.
MEDIA_ROOT=.media
# S3_BUCKET=cms-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Set for MinIO / Cloudflare R2 and other S3-compatible services:
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# A CDN in front of the bucket; when set, asset URLs are unsigned and cacheable.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ---- Security ----
# Comma-separated origins allowed to call the Admin API (§14.6).
ADMIN_CORS_ORIGINS=http://localhost:5173
# Set false to skip the HaveIBeenPwned k-anonymity check (offline dev).
PASSWORD_PWNED_CHECK=true
