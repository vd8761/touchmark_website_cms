{
  "name": "@cms/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "npm run db:deploy && npm run db:rls && npm run start",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 20",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern \"src/.*\\.spec\\.ts$\"",
    "test:isolation": "jest --config jest.config.js --runInBand --testPathPattern \"test/.*\\.e2e-spec\\.ts$\"",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:rls": "dotenv -e ../../.env -- ts-node scripts/apply-rls.ts",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "admin:create": "dotenv -e ../../.env -- ts-node scripts/create-admin.ts",
    "openapi": "dotenv -e ../../.env -- ts-node scripts/emit-openapi.ts",
    "db:backup": "dotenv -e ../../.env -- ts-node scripts/backup.ts",
    "db:restore": "dotenv -e ../../.env -- ts-node -e \"process.env.BACKUP_MODE='restore';require('./scripts/backup.ts')\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@cms/shared": "*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
