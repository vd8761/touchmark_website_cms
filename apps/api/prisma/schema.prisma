// Phase 0 data model — spec §5.1 (identity & tenancy) plus the cross-cutting
// audit log (§5.6) and the domain-event outbox (§4.7).
//
// Conventions that later phases must follow (spec §5):
//   * UUID v7 primary keys, generated in the application (see src/common/uuid.ts).
//     Postgres has no native v7 generator, so `@default` is deliberately absent.
//   * createdAt / updatedAt on every table; deletedAt where soft deletion applies.
//   * workspaceId on every tenant-owned table, NOT NULL, first column of every
//     composite index (§4.4 safeguard 1).
//   * Every uniqueness constraint is workspace-scoped (§4.4 safeguard 2).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Migrations run as the owner role; the app connects as an unprivileged role
  // so Row-Level Security actually applies to it (§4.4 safeguard 4).
  directUrl  = env("DATABASE_ADMIN_URL")
  extensions = [citext, pgcrypto]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  deleted
}

enum OrgPlan {
  free
  starter
  growth
  enterprise
}

enum OrgStatus {
  active
  past_due
  suspended
}

enum OrgRole {
  owner
  admin
  billing
  member
}

enum WorkspaceRole {
  site_admin
  editor
  author
  marketer
  analyst
}

enum WorkspaceStatus {
  active
  archived
}

enum ActorType {
  user
  api_key
  system
}

enum EmailProvider {
  resend
}

enum EmailConfigStatus {
  pending
  active
  invalid
  disabled
}

enum SenderIdentityStatus {
  pending
  verified
  failed
  revoked
}

enum ApiKeyType {
  publishable
  secret
}

enum ApiKeyEnvironment {
  live
  test
}

enum ApiKeyStatus {
  active
  revoked
}

enum SubscriberStatus {
  subscribed
  unsubscribed
  bounced
  complained
}

enum WebhookEndpointStatus {
  active
  disabled
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  dead_lettered
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id              String     @id @db.Uuid
  email           String     @unique @db.Citext
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?    @map("password_hash")
  fullName        String?    @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  timezone        String     @default("UTC")
  locale          String     @default("en")

  mfaEnabled       Boolean  @default(false) @map("mfa_enabled")
  mfaSecret        String?  @map("mfa_secret")
  mfaRecoveryCodes String[] @default([]) @map("mfa_recovery_codes")

  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  status      UserStatus @default(active)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  orgMemberships       OrganisationMember[]
  workspaceMemberships WorkspaceMember[]
  sessions             Session[]
  emailTokens          EmailToken[]
  sentInvitations      Invitation[]         @relation("InvitedBy")
  createdWorkspaces    Workspace[]          @relation("WorkspaceCreatedBy")
  ownedWorkspaces      Workspace[]          @relation("WorkspaceOwnedBy")

  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// Sessions rotated from the same login share a family id. Reuse of a rotated
  /// token revokes the whole family — theft detection, §6.1.
  familyId         String    @map("family_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens for email verification and password reset (§6.1).
/// Stored hashed; the plaintext only ever exists in the email that was sent.
model EmailToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organisation {
  id                 String    @id @db.Uuid
  name               String
  slug               String    @unique
  logoUrl            String?   @map("logo_url")
  plan               OrgPlan   @default(free)
  billingEmail       String?   @map("billing_email") @db.Citext
  billingCustomerRef String?   @map("billing_customer_ref")
  status             OrgStatus @default(active)
  settings           Json      @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  members      OrganisationMember[]
  workspaces   Workspace[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  emailConfigs EmailConfiguration[]

  @@map("organisations")
}

/// Provider credentials, owned by the organisation rather than the workspace.
///
/// This departs from spec §5.5, which puts ESP credentials at the platform
/// level and sender identities at the workspace level. An organisation can hold
/// several configurations (say, one Resend account per brand or per region) and
/// each workspace picks one, so billing and deliverability reputation follow the
/// organisation's own provider accounts rather than a shared platform account.
///
/// Consequences that fall out of this and are enforced below:
///   * the API key is encrypted at rest and never returned by any endpoint;
///   * each configuration has its own inbound webhook and signing secret, so a
///     rotated or compromised secret is contained to one configuration;
///   * a workspace may only send from a domain verified in the configuration it
///     is attached to.
model EmailConfiguration {
  id             String        @id @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  name           String
  provider       EmailProvider @default(resend)

  /// AES-256-GCM envelope-encrypted (§18.2). Never selected into a DTO.
  apiKeyCiphertext String @map("api_key_ciphertext")
  /// Shown in the UI so a key can be identified without revealing it.
  apiKeyLastFour   String @map("api_key_last_four")

  /// Per-configuration inbound webhook. The id forms the public path
  /// (/webhooks/email/:id) and the secret verifies Resend's Svix signature.
  webhookSecret     String    @map("webhook_secret")
  webhookLastEventAt DateTime? @map("webhook_last_event_at") @db.Timestamptz(6)
  webhookEventCount  Int       @default(0) @map("webhook_event_count")

  status         EmailConfigStatus @default(pending)
  statusDetail   String?           @map("status_detail")
  /// Domains Resend reports as verified, cached from the provider.
  verifiedDomains Json             @default("[]") @map("verified_domains")
  lastVerifiedAt  DateTime?        @map("last_verified_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workspaces       Workspace[]
  senderIdentities SenderIdentity[]

  @@unique([organisationId, name])
  @@index([organisationId, status])
  @@map("email_configurations")
}

/// A verified "from" address for one workspace (§5.5), bound to the
/// organisation-level configuration that will actually send it.
model SenderIdentity {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  /// Which organisation configuration sends this address. Denormalised from the
  /// workspace so an identity keeps working if the workspace later switches
  /// configuration — the switch has to re-verify identities explicitly.
  emailConfigurationId String @map("email_configuration_id") @db.Uuid

  fromName     String  @map("from_name")
  fromEmail    String  @map("from_email") @db.Citext
  replyToEmail String? @map("reply_to_email") @db.Citext

  status       SenderIdentityStatus @default(pending)
  statusDetail String?              @map("status_detail")
  verifiedAt   DateTime?            @map("verified_at") @db.Timestamptz(6)
  isDefault    Boolean              @default(false) @map("is_default")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailConfiguration EmailConfiguration @relation(fields: [emailConfigurationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fromEmail])
  @@index([workspaceId, status])
  @@map("sender_identities")
}

model ApiKey {
  id          String            @id @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  name        String
  type        ApiKeyType
  environment ApiKeyEnvironment @default(live)

  /// SHA-256 of the full key. The plaintext is shown exactly once on creation.
  keyHash     String @unique @map("key_hash")
  keyPrefix   String @map("key_prefix")
  keyLastFour String @map("key_last_four")

  scopes         String[] @default([])
  allowedOrigins String[] @default([]) @map("allowed_origins")
  allowedIps     String[] @default([]) @map("allowed_ips")
  rateLimitPerMinute Int? @map("rate_limit_per_minute")

  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz(6)
  status     ApiKeyStatus @default(active)
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(6)
  usageCount Int          @default(0) @map("usage_count")

  rotatedFromId       String?   @map("rotated_from_id") @db.Uuid
  rotatedToId         String?   @map("rotated_to_id") @db.Uuid
  rotationGraceEndsAt DateTime? @map("rotation_grace_ends_at") @db.Timestamptz(6)

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid
  createdBy String?   @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestLogs ApiRequestLog[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, type, environment])
  @@index([workspaceId, rotatedFromId])
  @@map("api_keys")
}

model ApiRequestLog {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  apiKeyId    String? @map("api_key_id") @db.Uuid

  method     String
  path       String
  statusCode Int     @map("status_code")
  errorCode  String? @map("error_code")
  ip         String? @db.Inet
  origin     String?
  userAgent  String? @map("user_agent")
  durationMs Int     @map("duration_ms")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey    ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([workspaceId, apiKeyId, occurredAt(sort: Desc)])
  @@index([apiKeyId, occurredAt(sort: Desc)])
  @@map("api_request_logs")
}

// ===========================================================================
// Phase 2 — Delivery audience, forms, preview and webhooks
// ===========================================================================

model Subscriber {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  email     String           @db.Citext
  status    SubscriberStatus @default(subscribed)
  firstName String?          @map("first_name")
  lastName  String?          @map("last_name")
  attributes Json            @default("{}")
  tags       String[]        @default([])
  source     String?

  consentAt      DateTime? @map("consent_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  bouncedAt      DateTime? @map("bounced_at") @db.Timestamptz(6)
  complainedAt   DateTime? @map("complained_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships SubscriberListMembership[]
  submissions FormSubmission[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("subscribers")
}

model AudienceList {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  name        String
  apiId       String  @map("api_id")
  description String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships SubscriberListMembership[]
  forms       Form[]

  @@unique([workspaceId, apiId])
  @@index([workspaceId, deletedAt])
  @@map("audience_lists")
}

model SubscriberListMembership {
  workspaceId  String @map("workspace_id") @db.Uuid
  subscriberId String @map("subscriber_id") @db.Uuid
  listId       String @map("list_id") @db.Uuid

  subscribedAt   DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriber Subscriber   @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  list       AudienceList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([subscriberId, listId])
  @@index([workspaceId, listId])
  @@index([workspaceId, subscriberId])
  @@map("subscriber_list_memberships")
}

model Form {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  listId      String? @map("list_id") @db.Uuid

  name           String
  apiId          String  @map("api_id")
  description    String?
  schema         Json    @default("[]")
  successMessage String  @default("Thanks - you're on the list.") @map("success_message")
  isEnabled      Boolean @default(true) @map("is_enabled")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list        AudienceList?    @relation(fields: [listId], references: [id], onDelete: SetNull)
  submissions FormSubmission[]

  @@unique([workspaceId, apiId])
  @@index([workspaceId, isEnabled])
  @@map("forms")
}

model FormSubmission {
  id           String  @id @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  formId       String  @map("form_id") @db.Uuid
  subscriberId String? @map("subscriber_id") @db.Uuid

  email     String? @db.Citext
  payload   Json    @default("{}")
  ip        String? @db.Inet
  userAgent String? @map("user_agent")
  referrer  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form       Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  subscriber Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, formId, createdAt(sort: Desc)])
  @@index([workspaceId, subscriberId])
  @@map("form_submissions")
}

model PreviewToken {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  entryId     String @map("entry_id") @db.Uuid

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entry     ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entryId, expiresAt])
  @@index([expiresAt])
  @@map("preview_tokens")
}

model WebhookEndpoint {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  name       String
  url        String
  events     String[]              @default([])
  secretCiphertext String          @map("secret_ciphertext")
  secretLastFour   String          @map("secret_last_four")
  status     WebhookEndpointStatus @default(active)

  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt       DateTime? @map("last_failure_at") @db.Timestamptz(6)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  webhookId   String @map("webhook_id") @db.Uuid
  eventId     String @map("event_id") @db.Uuid

  eventType String                @map("event_type")
  payload   Json                  @default("{}")
  status    WebhookDeliveryStatus @default(pending)
  attempt   Int                   @default(0)

  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  requestHeaders Json?    @map("request_headers")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  error          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhook   WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, webhookId, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("webhook_deliveries")
}

model OrganisationMember {
  id             String   @id @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole  @default(member)
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  invitedBy      String?  @map("invited_by") @db.Uuid
  lastActiveAt   DateTime? @map("last_active_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, role])
  @@map("organisation_members")
}

/// Labelled "Site" in the admin UI, "Workspace" in code, DB and API (§2.1).
model Workspace {
  id             String @map("id") @id @db.Uuid
  organisationId String @map("organisation_id") @db.Uuid

  name          String
  slug          String
  description   String?
  iconUrl       String?         @map("icon_url")
  colour        String          @default("#4F46E5")
  primaryUrl    String?         @map("primary_url")
  timezone      String          @default("UTC")
  defaultLocale String          @default("en") @map("default_locale")
  locales       String[]        @default(["en"])
  status        WorkspaceStatus @default(active)
  settings      Json            @default("{}")
  createdBy     String?         @map("created_by") @db.Uuid

  /// The site's owner — distinct from `createdBy`, which is history and never
  /// changes. Ownership moves between people (§6.3 transfer); the owner always
  /// holds Site Admin and cannot be demoted or removed from the members list,
  /// so a site can never end up with nobody accountable for it.
  ownerId String? @map("owner_id") @db.Uuid

  /// Set when a delete is requested; the 30-day soft-delete window of §6.3.
  purgeAfter DateTime? @map("purge_after") @db.Timestamptz(6)

  /// The organisation email configuration this site sends through — the
  /// "dropdown" in Site settings → Email. Null means the site cannot send yet.
  emailConfigurationId String? @map("email_configuration_id") @db.Uuid
  /// The site's preferred from-address, chosen after picking a configuration.
  defaultSenderIdentityId String? @map("default_sender_identity_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  creator      User?             @relation("WorkspaceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  owner        User?             @relation("WorkspaceOwnedBy", fields: [ownerId], references: [id], onDelete: SetNull)
  members      WorkspaceMember[]
  auditLogs    AuditLog[]

  // Detaching rather than cascading: deleting an email configuration must not
  // delete the sites that were sending through it.
  emailConfiguration EmailConfiguration? @relation(fields: [emailConfigurationId], references: [id], onDelete: SetNull)
  senderIdentities   SenderIdentity[]
  apiKeys            ApiKey[]
  apiRequestLogs     ApiRequestLog[]
  subscribers        Subscriber[]
  audienceLists      AudienceList[]
  subscriberLists    SubscriberListMembership[]
  forms              Form[]
  formSubmissions    FormSubmission[]
  previewTokens      PreviewToken[]
  webhookEndpoints   WebhookEndpoint[]
  webhookDeliveries  WebhookDelivery[]

  contentTypes ContentType[]
  entries      ContentEntry[]
  taxonomies   Taxonomy[]
  menus        Menu[]
  mediaFolders MediaFolder[]
  mediaAssets  MediaAsset[]

  @@unique([organisationId, slug])
  @@index([organisationId, status])
  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  addedBy     String?       @map("added_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model Invitation {
  id              String    @id @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  email           String    @db.Citext
  orgRole         OrgRole   @default(member) @map("org_role")
  /// `[{ workspace_id, role }]` — per-site grants applied on acceptance (§6.4).
  workspaceGrants Json      @default("[]") @map("workspace_grants")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  invitedBy       String?   @map("invited_by") @db.Uuid
  lastSentAt      DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  inviter      User?        @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([organisationId, acceptedAt])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Append-only (§5.6). The RLS policy grants INSERT and SELECT but never
/// UPDATE or DELETE, so "append-only" is enforced by the database, not by
/// convention.
model AuditLog {
  id             String    @id @db.Uuid
  organisationId String?   @map("organisation_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.Uuid
  actorLabel     String?   @map("actor_label")
  action         String
  resourceType   String    @map("resource_type")
  resourceId     String?   @map("resource_id")
  before         Json?
  after          Json?
  ip             String?   @db.Inet
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt(sort: Desc)])
  @@index([organisationId, occurredAt(sort: Desc)])
  @@index([workspaceId, resourceType, resourceId])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

/// Transactional outbox (§4.7). An event row is written in the same transaction
/// as the state change, so an event is never lost if the process dies between
/// the commit and the publish.
model DomainEvent {
  id          String    @id @db.Uuid
  workspaceId String?   @map("workspace_id") @db.Uuid
  orgId       String?   @map("org_id") @db.Uuid
  type        String
  payload     Json      @default("{}")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, occurredAt])
  @@index([workspaceId, type])
  @@map("domain_events")
}

// ===========================================================================
// Phase 1 — Content core (spec §5.2, §5.3, §7)
// ===========================================================================

enum ContentTypeKind {
  collection
  single
}

enum FieldType {
  text
  long_text
  rich_text
  markdown
  number
  decimal
  boolean
  date
  datetime
  enum
  multi_enum
  slug
  url
  email
  colour
  json
  media
  media_list
  relation_one
  relation_many
  geo
  code
}

enum EntryStatus {
  draft
  in_review
  changes_requested
  scheduled
  published
  archived
}

enum ReviewStatus {
  open
  approved
  rejected
}

/// A user-defined schema (§7.1). Created at runtime; no deployment required.
model ContentType {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  name String
  /// Immutable after creation — changing it would break every consumer (§7.1).
  apiId       String          @map("api_id")
  description String?
  kind        ContentTypeKind @default(collection)
  icon        String?

  slugFieldId  String? @map("slug_field_id") @db.Uuid
  titleFieldId String? @map("title_field_id") @db.Uuid

  hasSlug          Boolean     @default(true) @map("has_slug")
  isLocalised      Boolean     @default(false) @map("is_localised")
  enableVersioning Boolean     @default(true) @map("enable_versioning")
  enableScheduling Boolean     @default(true) @map("enable_scheduling")
  requireReview    Boolean     @default(false) @map("require_review")
  defaultStatus    EntryStatus @default(draft) @map("default_status")
  sortOrder        Int         @default(0) @map("sort_order")

  /// Bumped on every schema change and returned in Delivery API responses so
  /// consumers can detect drift (§7.1).
  schemaVersion Int @default(1) @map("schema_version")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields    ContentField[]
  entries   ContentEntry[]

  @@unique([workspaceId, apiId])
  @@index([workspaceId, sortOrder])
  @@map("content_types")
}

model ContentField {
  id            String @id @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  contentTypeId String @map("content_type_id") @db.Uuid

  name  String
  apiId String    @map("api_id")
  type  FieldType

  position    Int
  required    Boolean @default(false)
  localised   Boolean @default(false)
  uniqueValue Boolean @default(false) @map("unique_value")

  defaultValue Json?   @map("default_value")
  helpText     String? @map("help_text")
  /// min, max, regex, allowed values, file size/type (§5.2).
  validation Json @default("{}")
  /// Type-specific: relation target, enum options, editor toolbar (§5.2).
  config Json    @default("{}")
  group  String?

  /// §7.1 requires deletion to be two-step: a deprecated field is hidden from
  /// the editor but still served by the API, so consumers keep working while
  /// they migrate.
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, apiId])
  @@index([workspaceId, contentTypeId, position])
  @@map("content_fields")
}

model ContentEntry {
  id            String @id @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  contentTypeId String @map("content_type_id") @db.Uuid

  slug   String?
  locale String @default("en")
  /// Groups the locale variants of one logical entry.
  translationGroupId String @map("translation_group_id") @db.Uuid

  status EntryStatus @default(draft)
  data   Json        @default("{}")
  seo    Json        @default("{}")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  unpublishAt DateTime? @map("unpublish_at") @db.Timestamptz(6)

  currentVersion   Int  @default(1) @map("current_version")
  publishedVersion Int? @map("published_version")
  /// True when a required field was added after this entry was last saved
  /// (§7.1). Blocks re-publish until filled; the live version stays up.
  isIncomplete Boolean @default(false) @map("is_incomplete")

  authorId     String? @map("author_id") @db.Uuid
  lastEditedBy String? @map("last_edited_by") @db.Uuid

  /// Soft edit lock, expiring after 10 minutes idle (§5.2).
  lockedBy String?   @map("locked_by") @db.Uuid
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// The search document — slug plus every string value in `data`.
  ///
  /// A STORED GENERATED column maintained by Postgres, so it can never fall out
  /// of step with the row and nothing in the application has to remember to
  /// update it. Prisma has no tsvector type and never writes this column; see
  /// `migrations/20260810060000_content_search_vector`.
  searchVector Unsupported("tsvector")? @map("search_vector")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contentType ContentType      @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)
  versions    ContentVersion[]
  terms       EntryTerm[]
  reviews     ReviewRequest[]
  previewTokens PreviewToken[]

  @@unique([workspaceId, contentTypeId, slug, locale])
  @@index([workspaceId, contentTypeId, status, publishedAt(sort: Desc)])
  @@index([workspaceId, translationGroupId])
  @@index([status, scheduledAt])
  @@map("content_entries")
}

/// Immutable snapshots. Retention: last 50 per entry, plus every version that
/// was ever published, forever (§5.2).
model ContentVersion {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  entryId     String @map("entry_id") @db.Uuid

  version      Int
  data         Json
  seo          Json        @default("{}")
  statusAtSave EntryStatus @map("status_at_save")
  changeNote   String?     @map("change_note")
  /// Set when this version was published; such versions are never pruned.
  wasPublished Boolean @default(false) @map("was_published")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@index([workspaceId, entryId, version(sort: Desc)])
  @@map("content_versions")
}

model Taxonomy {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  name           String
  apiId          String  @map("api_id")
  description    String?
  isHierarchical Boolean @default(false) @map("is_hierarchical")
  /// Content types this taxonomy applies to; empty means all.
  appliesTo String[] @default([]) @map("applies_to")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  terms     TaxonomyTerm[]

  @@unique([workspaceId, apiId])
  @@map("taxonomies")
}

model TaxonomyTerm {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  taxonomyId  String  @map("taxonomy_id") @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid

  name        String
  slug        String
  description String?
  position    Int     @default(0)
  meta        Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  taxonomy Taxonomy       @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)
  parent   TaxonomyTerm?  @relation("TermTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TaxonomyTerm[] @relation("TermTree")
  entries  EntryTerm[]

  @@unique([workspaceId, taxonomyId, slug])
  @@index([workspaceId, taxonomyId, position])
  @@map("taxonomy_terms")
}

model EntryTerm {
  entryId     String @map("entry_id") @db.Uuid
  termId      String @map("term_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  term  TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([entryId, termId])
  @@index([workspaceId, termId])
  @@map("entry_terms")
}

model Menu {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  name        String
  apiId       String  @map("api_id")
  locale      String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@unique([workspaceId, apiId])
  @@map("menus")
}

model MenuItem {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  menuId      String  @map("menu_id") @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid

  label    String
  linkType String  @default("url") @map("link_type")
  entryId  String? @map("entry_id") @db.Uuid
  termId   String? @map("term_id") @db.Uuid
  url      String?
  target   String  @default("_self")
  icon     String?
  position Int     @default(0)
  visible  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@index([workspaceId, menuId, position])
  @@map("menu_items")
}

model ReviewRequest {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  entryId     String @map("entry_id") @db.Uuid

  requestedBy String       @map("requested_by") @db.Uuid
  assignedTo  String?      @map("assigned_to") @db.Uuid
  status      ReviewStatus @default(open)
  comment     String?
  resolvedBy  String?      @map("resolved_by") @db.Uuid
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entryId, status])
  @@index([workspaceId, assignedTo, status])
  @@map("review_requests")
}

model MediaFolder {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  parentId    String? @map("parent_id") @db.Uuid
  name        String
  path        String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[]

  @@unique([workspaceId, path])
  @@map("media_folders")
}

model MediaAsset {
  id          String  @id @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  folderId    String? @map("folder_id") @db.Uuid

  filename   String
  storageKey String @map("storage_key")
  mimeType   String @map("mime_type")
  sizeBytes  BigInt @map("size_bytes")

  width      Int?
  height     Int?
  durationMs Int? @map("duration_ms")
  /// sha256, used to dedupe uploads within a workspace.
  checksum String?

  altText  String?  @map("alt_text")
  altI18n  Json     @default("{}") @map("alt_i18n")
  caption  String?
  credit   String?
  tags     String[] @default([])
  blurhash String?
  variants Json     @default("[]")

  /// Set once the client confirms the upload finished. Rows without it are
  /// abandoned uploads and are swept up by a cleanup job.
  uploadedAt DateTime? @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy String?   @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  usages    MediaUsage[]

  @@index([workspaceId, folderId, createdAt(sort: Desc)])
  @@index([workspaceId, checksum])
  @@map("media_assets")
}

/// Populated on entry save; powers the "used in 4 places" warning before
/// deletion (§5.3).
model MediaUsage {
  id          String @id @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  assetId     String @map("asset_id") @db.Uuid
  entryId     String @map("entry_id") @db.Uuid
  fieldApiId  String @map("field_api_id")

  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, entryId, fieldApiId])
  @@index([workspaceId, entryId])
  @@map("media_usages")
}

// ---------------------------------------------------------------------------
// Background jobs
// ---------------------------------------------------------------------------

enum JobStatus {
  pending
  running
  completed
  failed
  dead_lettered
}

/// The work queue (§4.6).
///
/// Postgres rather than a broker: this platform already requires Postgres and
/// nothing else, and one storage system that the operator must back up, restore
/// and monitor is worth more than the throughput a dedicated queue would add.
/// Workers claim rows with `FOR UPDATE SKIP LOCKED`, so several API instances
/// can share the queue without ever handing the same job to two of them.
///
/// Deliberately carries no `workspace_id` column. The worker runs outside any
/// request context and must see every tenant's work, but the isolation suite
/// enforces "a table with workspace_id has RLS enabled and forced" with no
/// exceptions — and that invariant is worth more than a convenience column.
/// A job that belongs to a workspace names it inside `payload`.
model Job {
  id      String    @id @db.Uuid
  name    String
  payload Json      @default("{}")
  status  JobStatus @default(pending)

  /// Set for recurring jobs. After a run the worker schedules the next
  /// occurrence this far ahead, so there is no cron parser to maintain.
  intervalMs Int? @map("interval_ms")

  /// Deduplication handle. A recurring job uses a stable key so restarting an
  /// instance re-uses its row instead of adding another copy of the schedule.
  dedupeKey String? @unique @map("dedupe_key")

  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The claim query orders by run_at over pending rows; this index is what
  /// keeps that a scan of the due rows rather than of the whole table.
  @@index([status, runAt])
  @@map("jobs")
}

/// Fixed-window request counters for Delivery API rate limiting (§12.3).
///
/// One row per (key, window), incremented with an atomic upsert. Fixed windows
/// rather than a sliding log because the sliding version needs one row per
/// request; at the limits this platform enforces, the difference in fairness is
/// a burst at a window boundary, and the burst allowance already tolerates that.
model RateLimitCounter {
  bucket      String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}
